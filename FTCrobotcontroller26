
package org.firstinspires.ftc.teamcode;

// FTC SDK imports
import com.qualcomm.robotcore.eventloop.opmode.TeleOp;
import com.qualcomm.robotcore.eventloop.opmode.LinearOpMode;
import com.qualcomm.robotcore.hardware.DcMotor;

@TeleOp(name = "Competition TeleOp", group = "Competition")

public class CompetitionTeleOp extends LinearOpMode {

    // =========================================
    // CONTROL HUB - MECANUM DRIVE
    // =========================================

    private DcMotor backLeft;
    private DcMotor backRight;
    private DcMotor frontLeft;
    private DcMotor frontRight;

    // =========================================
    // EXPANSION HUB - MECHANISMS
    // =========================================

    private DcMotor shooter;
    private DcMotor player2Motor;
    private DcMotor mechanism;

    @Override
    public void runOpMode() {

        // =========================================
        // 1. HARDWARE CONFIGURATION
        // =========================================

        // Control Hub
        backLeft = hardwareMap.get(DcMotor.class, "backLeft");
        backRight = hardwareMap.get(DcMotor.class, "backRight");
        frontLeft = hardwareMap.get(DcMotor.class, "frontLeft");
        frontRight = hardwareMap.get(DcMotor.class, "frontRight");

        // Expansion Hub
        shooter = hardwareMap.get(DcMotor.class, "shooter");
        player2Motor = hardwareMap.get(DcMotor.class, "player2Motor");
        mechanism = hardwareMap.get(DcMotor.class, "mechanism");

        // =========================================
        // 2. MOTOR DIRECTIONS
        // =========================================

        // Mecanum drive
        backLeft.setDirection(DcMotor.Direction.REVERSE);
        frontLeft.setDirection(DcMotor.Direction.REVERSE);

        backRight.setDirection(DcMotor.Direction.FORWARD);
        frontRight.setDirection(DcMotor.Direction.FORWARD);

        // Other motors
        shooter.setDirection(DcMotor.Direction.FORWARD);
        mechanism.setDirection(DcMotor.Direction.FORWARD);
        player2Motor.setDirection(DcMotor.Direction.FORWARD);

        // =========================================
        // 3. MOTOR BRAKING
        // =========================================

        DcMotor[] motors = {
            backLeft,
            backRight,
            frontLeft,
            frontRight,
            shooter,
            mechanism,
            player2Motor
        };

        for (DcMotor motor : motors) {
            motor.setZeroPowerBehavior(
                DcMotor.ZeroPowerBehavior.BRAKE
            );

            motor.setPower(0.0);
        }

        // =========================================
        // 4. READY MESSAGE
        // =========================================

        telemetry.addLine("FTC COMPETITION ROBOT");
        telemetry.addLine("Java TeleOp initialized");
        telemetry.addLine("Player 1: Drive + Mechanisms");
        telemetry.addLine("Player 2: Extra Motor");
        telemetry.addLine("ALL MOTORS: FULL POWER");
        telemetry.addLine("Waiting for START...");
        telemetry.update();

        waitForStart();

        // =========================================
        // 5. MOTOR STATES
        // =========================================

        boolean shooterRunning = false;
        boolean mechanismRunning = false;
        boolean player2Running = false;

        // =========================================
        // 6. MAIN CONTROL LOOP
        // =========================================

        while (opModeIsActive()) {

            // =====================================
            // PLAYER 1 - MECANUM DRIVE
            // =====================================

            double y = -gamepad1.left_stick_y;
            double x = gamepad1.left_stick_x;
            double rx = gamepad1.right_stick_x;

            // Mecanum calculations
            double denominator = Math.max(
                Math.abs(y) + Math.abs(x) + Math.abs(rx),
                1.0
            );

            double frontLeftPower =
                (y + x + rx) / denominator;

            double backLeftPower =
                (y - x + rx) / denominator;

            double frontRightPower =
                (y - x - rx) / denominator;

            double backRightPower =
                (y + x - rx) / denominator;

            // Apply motor power
            frontLeft.setPower(frontLeftPower);
            backLeft.setPower(backLeftPower);

            frontRight.setPower(frontRightPower);
            backRight.setPower(backRightPower);

            // =====================================
            // PLAYER 1 - SHOOTER
            // L2 = START
            // R2 = STOP
            // =====================================

            if (gamepad1.left_trigger > 0.5) {
                shooterRunning = true;
            }

            if (gamepad1.right_trigger > 0.5) {
                shooterRunning = false;
            }

            shooter.setPower(
                shooterRunning ? -1.0 : 0.0
            );

            // =====================================
            // PLAYER 1 - MECHANISM
            // L1 = START
            // R1 = STOP
            // =====================================

            if (gamepad1.left_bumper) {
                mechanismRunning = true;
            }

            if (gamepad1.right_bumper) {
                mechanismRunning = false;
            }

            mechanism.setPower(
                mechanismRunning ? 1.0 : 0.0
            );

            // =====================================
            // PLAYER 2 - EXTRA MOTOR
            // L2 = START
            // R2 = STOP
            // =====================================

            if (gamepad2.left_trigger > 0.5) {
                player2Running = true;
            }

            if (gamepad2.right_trigger > 0.5) {
                player2Running = false;
            }

            player2Motor.setPower(
                player2Running ? 1.0 : 0.0
            );

            // =====================================
            // 7. TELEMETRY
            // =====================================

            telemetry.addLine("=== ROBOT STATUS ===");

            telemetry.addData(
                "Player 1 Drive", "ACTIVE"
            );

            telemetry.addData(
                "Shooter",
                shooterRunning ? "RUNNING 100%" : "STOPPED"
            );

            telemetry.addData(
                "Mechanism",
                mechanismRunning ? "RUNNING 100%" : "STOPPED"
            );

            telemetry.addData(
                "Player 2 Motor",
                player2Running ? "RUNNING 100%" : "STOPPED"
            );

            telemetry.update();
        }

        // =========================================
        // 8. STOP ALL MOTORS
        // =========================================

        for (DcMotor motor : motors) {
            motor.setPower(0.0);
        }
    }
}
